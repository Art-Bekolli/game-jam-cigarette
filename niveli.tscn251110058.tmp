[sub_resource type="GDScript" id="GDScript_7exjq"]
resource_name = "tipi"
script/source = "extends CharacterBody3D

const SPEED = 5.0
const JUMP_VELOCITY = 4.5

# Controls how fast the camera moves with the mouse
var mouse_sensitivity = 0.002

# Get the gravity from the project settings
var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

# Grab the Camera3D node from your scene tree
@onready var camera = $Camera3D

func _ready():
	# Locks the mouse cursor to the center of the game window and hides it
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

func _unhandled_input(event):
	# Handle Mouse Look
	if event is InputEventMouseMotion:
		# Rotate the whole player body left and right
		rotate_y(-event.relative.x * mouse_sensitivity)
		# Rotate only the camera up and down
		camera.rotate_x(-event.relative.y * mouse_sensitivity)
		# Clamp the camera so you can't snap your neck looking too far up/down
		camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-90), deg_to_rad(90))
		
	# Optional: Press Escape to free the mouse cursor for debugging
	if Input.is_action_just_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

func _physics_process(delta):
	# Apply Gravity
	if not is_on_floor():
		velocity.y -= gravity * delta

	# Handle Jump (Uses the default \"ui_accept\" action, usually Spacebar)
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Handle Movement
	var input_dir = Input.get_vector(\"left\", \"right\", \"forward\", \"back\")
	
	# transform.basis ensures the character moves relative to where they are currently looking
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	
	if direction:
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
	else:
		# Adds friction so you stop moving when you let go of the keys
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	move_and_slide()
"


[sub_resource type="GDScript" id="GDScript_afelo"]
script/source = "extends Node3D

@export var floor_block_scene: PackedScene
@export var player: Node3D

const TOTAL_BLOCKS = 20
const BLOCK_SIZE = 4.0
# Increase this from 2 to 6 or 8 so blocks don't disappear in front of the camera
const VISIBLE_DISTANCE = 24.0 # 6 blocks * 4.0 size = 24 meters

var spawned_blocks: Array[Node3D] = []

func _ready():
	if not floor_block_scene:
		push_error(\"Please assign FloorBlock.tscn to the Inspector!\")
		return
		
	for i in range(TOTAL_BLOCKS):
		var block = floor_block_scene.instantiate() as Node3D
		add_child(block)
		block.position = Vector3(0, 0, -i * BLOCK_SIZE)
		spawned_blocks.append(block)

func _process(_delta):
	if not player:
		return

	for block in spawned_blocks:
		# Calculate actual 3D distance between player and block
		var dist = player.global_position.distance_to(block.global_position)
		
		# Show if within range
		block.visible = dist <= VISIBLE_DISTANCE
"


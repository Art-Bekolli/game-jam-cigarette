[sub_resource type="GDScript" id="GDScript_f2txt"]
script/source = "extends CanvasLayer

@onready var dialogi_bad: Control = $UI/DialogiBad
@onready var gameover: Control = %gameover
@onready var dialogi_good: Control = $UI/DialogiGood
@onready var dialogiyesno: Control = %dialogiyesno
@onready var main: Node3D = $\"..\"
@onready var sprite_chance: Node3D = $\"../SpriteChance\"
@onready var cig_counter: HBoxContainer = %CigCounter
@onready var dora_maci: TextureRect = $UI/DoraMaci
@onready var give: Label = $UI/DialogiBad/Give
@onready var take: Label = $UI/DialogiGood/Take
@onready var dora_keqi: TextureRect = $UI/DoraKeqi
@onready var dora_angk: TextureRect = $UI/DoraAngk
@onready var dora_bobi: TextureRect = $UI/DoraBobi
@onready var animated_sprite_3d_2: AnimatedSprite3D = $AnimatedSprite3D2

@onready var reload: AnimatedSprite2D = %reload

const CIG = preload(\"uid://c1jqwc3ww7gf5\")

var mir2:Array[String] = [
\"Hey, long time no see!\",
\"Only ten miles to heaven.\",
\"Here, have a cigarette from me, I hope you get there. Don’t mention it.\",
\"Here, have a cig!\",
\"Have a cig!\",
\"Kiss me!\",
\"You’re beautiful.\",
\"You want a ciggy?\",
\"Hold on. Hang on. Hang on.\",
\"Have a cig.\"
]

var mir1:Array[String] = [
\"What’s woung with youw face? You’we aaaall messed up.\",
\"Uhhh have this I found it on the ground. Weiwdo\",
\"You dwopped something, no wait, its mine, you can have it anyway!\",
\"Shhh, don’t tell anywone I gave you this. Hehehehe.\",
\"Is it stiwww night? Gosh! Fees wike it’s been night fowevew. Anyway! Here!\",
\"I found a whole box of these once next to my dad’s gun, you can have one!\",
\"Evewybody’s inside, ya know?! Anyway, I dunno, here!\"
]


var keqi1:Array[String] = [
\"Nevermind all that!\",
\". . . I know you have  one, give it here.\",
\"Hand over a cigarette, buddy.\",
\"Pass a cig.\",
\"I offer you hope!\",
\"Give me a ciggy as payment.\"
]

var keqi2:Array[String] = [
\"Humanity needs beauty\",
\"Humanity needs symbolism.\",
\"Criminal scum.\",
\"Holy Child, Hanging High.\",
\"Godless bastard, give me all you have!\",
\"Stop right there, you apostle of heresy.\",
\"Good Friday.\",
\"Everyone’s sinned by the time I get to them.\",
\"Pay in blood.\"
]


const MIRI_SHUME = preload(\"uid://cgyqlpbhrjmk4\")
const KEQI = preload(\"uid://dpd6p52ixl31j\")
const KEQISHUME = preload(\"uid://bk0ct5i0x0lq\")
const MIRI = preload(\"uid://c2qet2ncpdtwh\")


var isVisible = false 

func ChangeVisibilityState(state):
	dialogiyesno.visible = state


func onAnswer() -> void:
	ChangeVisibilityState(false)
	await get_tree().create_timer(2.5).timeout
	Global.currentIpit.queue_free()
	Global.playerCanMove = true
	main._spawn_enemy_3d()
	dialogi_good.visible = false 

func _on_no_pressed() -> void:
	onAnswer()

func _on_yes_pressed() -> void:
	onAnswer()
	match sprite_chance.tipiShanca():
		0:
			gotCigi(2)
			Global.currentIpit.get_node(\"AnimatedSprite3D\").texture = MIRI_SHUME
			take.text = mir1[randi_range(0,mir1.size() - 1)]
			
			dialogi_good.visible = true
			await get_tree().create_timer(.3).timeout
			dora_maci.visible = true
			await get_tree().create_timer(2.2).timeout
			dialogi_good.visible = false
			dora_maci.visible = false
			
		1:
			gotCigi(1)
			Global.currentIpit.get_node(\"AnimatedSprite3D\").texture = MIRI
			take.text = mir2[randi_range(0,mir2.size() - 1)]
			dialogi_good.visible = true
			await get_tree().create_timer(.3).timeout
			dora_bobi.visible = true
			await get_tree().create_timer(2.2).timeout
			dialogi_good.visible = false
			dora_bobi.visible = false
		2:
			byeCigi(1)
			Global.currentIpit.get_node(\"AnimatedSprite3D\").texture = KEQI
			give.text = keqi1[randi_range(0,keqi1.size() - 1)]
			dialogi_bad.visible = true
			await get_tree().create_timer(.3).timeout
			dora_keqi.visible = true
			await get_tree().create_timer(2.2).timeout
			dialogi_bad.visible = false
			dora_keqi.visible = false
		3:
			byeCigi(2)
			Global.currentIpit.get_node(\"AnimatedSprite3D\").texture = KEQISHUME
			
			give.text = keqi2[randi_range(0,keqi2.size() - 1)]
			dialogi_bad.visible = true
			await get_tree().create_timer(.3).timeout
			dora_angk.visible = true
			await get_tree().create_timer(2.2).timeout
			dialogi_bad.visible = false
			dora_angk.visible = false
		

func gotCigi(ncigi:int):
	for n in ncigi:
		reload.visible = true
		reload.play_backwards(\"relad\")
		var cigarja = CIG.instantiate()
		cig_counter.add_child(cigarja)
		await get_tree().create_timer(1.5).timeout
		reload.visible = false
		

func byeCigi(ncigi:int):
	
	for n in ncigi:
		reload.visible = true
		reload.play(\"relad\")
		if cig_counter.get_child(0) == null:
			gameover.visible = true
			return
		cig_counter.get_child(0).queue_free()
		await get_tree().create_timer(1.5).timeout
		reload.visible = false
		
"


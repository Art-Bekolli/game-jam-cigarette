[sub_resource type="GDScript" id="GDScript_7exjq"]
resource_name = "tipi"
script/source = "extends CharacterBody3D



const SPEED = 5.0

const JUMP_VELOCITY = 4.5

var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

@onready var ambient_audio: AudioStreamPlayer = $Ambient

@onready var main_theme: AudioStreamPlayer = $\"Main Theme\"

# --- UI Variables ---

@onready var smoke_bar: ProgressBar = %smoke_bar

@onready var smoke_particles: GPUParticles3D = $Camera3D/SmokeParticles

@onready var reload_sprite_3d: AnimatedSprite3D = $Camera3D/reloads # Ensure this matches your node name in Camera3D



# Sprite Textures

@export var default_texture: Texture2D

@export var smoking_texture: Texture2D



# Smoking Mechanic Variables

var is_smoking = false

var smoke_meter: float = 100.0

const MAX_SMOKE = 100.0

const DRAG_SENSITIVITY = 0.5

const DECAY_RATE: float = 8.0

var is_phone_talking: bool = false



# --- Drunk Tilt / Balance Mechanics ---

var tilt_angle: float = 0.0            # Current roll angle in degrees (- Left, + Right)

var tilt_target_dir: int = 0           # -1 = Falling Left, 1 = Falling Right, 0 = Upright

var tilt_timer: float = 2.0            # Delay before next stumble

const MAX_TILT: float = 45.0           # Maximum angle before player falls completely

const TILT_FALL_SPEED: float = 12.0    # Degrees per second the camera tilts (slowly falls over)

const MASH_RECOVERY: float = 3.0      # Degrees recovered per button tap

var visual_tilt: float = 0.0           # The smoothed angle the camera actually renders

const TILT_SMOOTHING: float = 12.0     # How fast the camera catches up (lower = floatier, higher = snappier)



# --- Fail State Variables ---

var is_failed: bool = false

var fall_timer: float = 0.0

const GROUND_EYE_HEIGHT: float = 0.3   # Height camera drops to when collapsed



# Idle / Walk Bobbing & Ambient Sway

const IDLE_BOB_FREQ = 2.0

const IDLE_BOB_AMP = 0.002

const WALK_BOB_FREQ = 10.0

const WALK_BOB_AMP = 0.003

var bob_time = 0.0

var sway_time = 0.0



@onready var camera = $Camera3D

@onready var sprite_3d = $Camera3D/Sprite3D

@onready var default_sprite_pos = sprite_3d.position

@onready var default_camera_y = camera.position.y



	func _ready():

Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

if smoke_bar:

smoke_bar.value = smoke_meter

ambient_audio.play()

main_theme.play()


if reload_sprite_3d:

reload_sprite_3d.visible = false

reload_sprite_3d.animation_finished.connect(_on_reload_animation_finished)



func play_reload_animation(backwards: bool = false) -> void:

if reload_sprite_3d:

reload_sprite_3d.visible = true

if backwards:

reload_sprite_3d.play_backwards(\"relad\")

else:

reload_sprite_3d.play(\"relad\")



func _on_reload_animation_finished() -> void:

reload_sprite_3d.visible = false

func _unhandled_input(event):

if is_failed:

return



# Smoking mouse controls

if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:

is_smoking = event.pressed

if is_smoking:

Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

if smoking_texture:

sprite_3d.texture = smoking_texture

else:

Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

if default_texture:

sprite_3d.texture = default_texture


# Blow smoke on release

if smoke_particles:

smoke_particles.restart() 



if event is InputEventMouseMotion and is_smoking:

if event.relative.y > 0:

smoke_meter = clamp(smoke_meter + (event.relative.y * (DRAG_SENSITIVITY * 0.005)), 0.0, MAX_SMOKE)

# --- Button Mashing to Upright Character ---

if tilt_target_dir != 0:

# If toppling LEFT (-1), tilt_angle is negative. Mash RIGHT to add positive recovery.

if tilt_target_dir == -1 and event.is_action_pressed(\"left\"):

tilt_angle += MASH_RECOVERY

if tilt_angle > 0: tilt_angle = 0 # Don't over-correct past center


# If toppling RIGHT (1), tilt_angle is positive. Mash LEFT to subtract recovery.

elif tilt_target_dir == 1 and event.is_action_pressed(\"right\"):

tilt_angle -= MASH_RECOVERY

if tilt_angle < 0: tilt_angle = 0 # Don't over-correct past center



# If we successfully leveled out (back to 0)

if abs(tilt_angle) <= 0.5:

tilt_angle = 0.0

tilt_target_dir = 0

tilt_timer = randf_range(2.0, 5.0) # Set timer for the next random topple



if Input.is_action_just_pressed(\"ui_cancel\"):

get_tree().quit()



func _physics_process(delta):

# --- Handle Fail State Collapse Animation ---

if is_failed:

velocity.x = 0

velocity.z = 0


# Drop camera down to floor height and roll sideways

camera.position.y = move_toward(camera.position.y, GROUND_EYE_HEIGHT, delta * 3.0)

camera.rotation_degrees.z = move_toward(camera.rotation_degrees.z, sign(tilt_angle) * 75.0, delta * 120.0)

camera.rotation_degrees.x = move_toward(camera.rotation_degrees.x, -15.0, delta * 60.0)

Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

get_tree().change_scene_to_file(\"res://game_over.tscn\") # Adjust path if in a subfolder like res://scenes/game_over.tscn


# Transition to Game Over scene after collapse animation finishes (2 seconds)

fall_timer += delta


# Restore mouse cursor visibility for the 2D Game Over UI



move_and_slide()

return

# --- Normal Game Loop ---

# If on the phone, multiply the decay rate by 3 (adjust as needed)

var current_decay = DECAY_RATE * 2.0 if is_phone_talking else DECAY_RATE

smoke_meter = max(smoke_meter - (current_decay * delta), 0.0)



if not is_on_floor():

velocity.y -= gravity * delta



if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():

velocity.y = JUMP_VELOCITY



_process_drunk_tilt(delta)



if Global.playerCanMove: 

var input_dir = Input.get_axis(\"forward\", \"back\")

var direction = (transform.basis * Vector3(0, 0, input_dir)).normalized()


if Global.playerCanMove: 

if direction:

velocity.x = direction.x * SPEED

velocity.z = direction.z * SPEED

else:

velocity.x = move_toward(velocity.x, 0, SPEED)

velocity.z = move_toward(velocity.z, 0, SPEED)



_handle_hand_bob(delta)


if smoke_bar:

smoke_bar.value = smoke_meter





_handle_hand_bob(delta)

_handle_camera_tilt_and_sway(delta)



if smoke_bar:

smoke_bar.value = smoke_meter



# Fail condition if smoke runs out

if smoke_meter <= 0.0:

is_failed = true



move_and_slide()



func _process_drunk_tilt(delta: float):

if tilt_target_dir == 0:

# Wait for timer to trigger next random topple direction

tilt_timer -= delta

if tilt_timer <= 0.0:

tilt_target_dir = -1 if randf() < 0.5 else 1

else:

# Slowly pull character over until player mashes key

tilt_angle += tilt_target_dir * TILT_FALL_SPEED * delta

tilt_angle = clamp(tilt_angle, -MAX_TILT, MAX_TILT)


# Check if player failed to mash in time and hit max tilt (45 degrees)

if abs(tilt_angle) >= MAX_TILT:

is_failed = true



func _handle_hand_bob(delta):

var horizontal_speed = Vector3(velocity.x, 0, velocity.z).length()

var is_moving = is_on_floor() and horizontal_speed > 0.1


var current_freq = WALK_BOB_FREQ if is_moving else IDLE_BOB_FREQ

var current_amp = WALK_BOB_AMP if is_moving else IDLE_BOB_AMP


bob_time += delta * current_freq

sprite_3d.position.y = default_sprite_pos.y + sin(bob_time) * current_amp



func _handle_camera_tilt_and_sway(delta):

# 1. Smoothly glide the visual_tilt toward the actual mechanical tilt_angle

visual_tilt = lerp(visual_tilt, tilt_angle, delta * TILT_SMOOTHING)



# 2. Calculate ambient drunk wobble

sway_time += delta * 0.7

var ambient_sway = sin(sway_time * 1.5) * 2.0

var ambient_pitch = cos(sway_time * 1.1) * 1.5


# 3. Apply the smoothed visual_tilt instead of the raw, snappy tilt_angle

camera.rotation_degrees.z = visual_tilt + ambient_sway

camera.rotation_degrees.x = ambient_pitch 
"

